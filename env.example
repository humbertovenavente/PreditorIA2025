# Archivo de configuración de ejemplo para PreditorIA2025
# Copia este archivo como .env y configura las variables según tu entorno

# ===========================================
# CONFIGURACIÓN DE LA BASE DE DATOS
# ===========================================
DATABASE_URL=sqlite:///data/fashion_analysis.db

# ===========================================
# CONFIGURACIÓN DE GOOGLE CLOUD (OPCIONAL)
# ===========================================
# Proyecto de Google Cloud Platform
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp

# Nombre del bucket en Google Cloud Storage
GCS_BUCKET_NAME=tu-bucket-fashion

# Ruta al archivo de credenciales JSON
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp-key.json

# ===========================================
# CONFIGURACIÓN DE LA APLICACIÓN FLASK
# ===========================================
# Entorno de Flask (development/production)
FLASK_ENV=development

# Modo debug (True/False)
FLASK_DEBUG=True

# Clave secreta para sesiones (cambiar en producción)
SECRET_KEY=tu-clave-secreta-muy-segura-cambiar-en-produccion

# Puerto de la aplicación web
FLASK_PORT=5000

# ===========================================
# CONFIGURACIÓN DEL SCRAPER
# ===========================================
# Número objetivo de imágenes a extraer
TARGET_IMAGES=5000

# Usar navegador en modo headless (True/False)
HEADLESS_BROWSER=true

# Delay entre requests (segundos)
REQUEST_DELAY=2

# ===========================================
# CONFIGURACIÓN DE MACHINE LEARNING
# ===========================================
# Usar GPU si está disponible (True/False)
USE_GPU=True

# Número de workers para procesamiento paralelo
NUM_WORKERS=4

# Tamaño del batch para procesamiento
BATCH_SIZE=32

# ===========================================
# CONFIGURACIÓN DE CLUSTERING
# ===========================================
# Número de clusters para K-Means
N_CLUSTERS=150

# Semilla aleatoria para reproducibilidad
RANDOM_STATE=42

# ===========================================
# CONFIGURACIÓN DE LOGGING
# ===========================================
# Nivel de logging (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Archivo de log principal
LOG_FILE=data/logs/main.log

# ===========================================
# CONFIGURACIÓN DE ALMACENAMIENTO
# ===========================================
# Directorio base para datos
DATA_ROOT=data

# Usar almacenamiento en la nube (True/False)
USE_CLOUD_STORAGE=False

# ===========================================
# CONFIGURACIÓN DE RED
# ===========================================
# Timeout para requests HTTP (segundos)
HTTP_TIMEOUT=30

# User-Agent para requests
USER_AGENT=Mozilla/5.0 (compatible; PreditorIA2025/1.0)

# ===========================================
# CONFIGURACIÓN DE SEGURIDAD
# ===========================================
# Habilitar CORS (True/False)
ENABLE_CORS=True

# Dominios permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ===========================================
# CONFIGURACIÓN DE DESARROLLO
# ===========================================
# Habilitar modo de desarrollo (True/False)
DEVELOPMENT_MODE=True

# Mostrar logs detallados (True/False)
VERBOSE_LOGGING=True

# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ===========================================
# Para producción, cambiar estos valores:
# FLASK_ENV=production
# FLASK_DEBUG=False
# SECRET_KEY=clave-super-secreta-y-larga-para-produccion
# DEVELOPMENT_MODE=False
# VERBOSE_LOGGING=False
